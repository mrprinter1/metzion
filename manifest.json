{
  "manifest_version": 3,
  "name": "מציאון",
  "version": "0.9.1",
  "description": "מסמן ביד 2 רכבים במחיר נמוך מהמחירון",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.yad2.co.il/*",
    "https://metzion.nivboros.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.yad2.co.il/vehicles/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.yad2.co.il/*"
      ],
      "js": [
        "src/proxy.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "מציאון · הגדרות",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}